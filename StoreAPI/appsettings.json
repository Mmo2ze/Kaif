{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5050"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=store.db"
  },
  "Jwt": {
    "Issuer": "StoreAPI",
    "Audience": "StoreClients",
    "SigningKey": "ChangeMe_UseAtLeast32Chars_DevOnly_ChangeMe_!",
    "ExpirationMinutes": 480
  },
  "Pos": {
    "AllowSellerDiscount": false,
    "LowStockThreshold": 5,
    "AdminDiscountPin": "1234"
  },
  "BackupSettings": {
    "DiscordWebhookUrl": "",
    "IntervalHours": 24,
    "DatabasePath": "store.db",
    "BackupTempFolder": "backups"
  }
}

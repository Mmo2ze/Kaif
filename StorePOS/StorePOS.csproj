<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Build Windows on Windows, Mac Catalyst on macOS (override with -f if needed). -->
    <TargetFrameworks Condition="$([MSBuild]::IsOsPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOsPlatform('OSX'))">net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFrameworks)' == ''">net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>StorePOS</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Store POS</ApplicationTitle>
    <ApplicationId>com.store.pos</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.60" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="System.Drawing.Common" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoreShared\StoreShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B6EC2" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1B6EC2" BaseSize="128,128" />
    <None Include="RunStore.bat" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="RunStore.sh" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Windows: self-contained POS + StoreAPI (win-x64). -->
  <Target Name="PublishAndMergeStoreApiWindows" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PropertyGroup>
      <_ApiStageDir>$(MSBuildThisFileDirectory)..\StoreAPI\bin\$(Configuration)\net10.0\win-x64\publish-staged</_ApiStageDir>
      <_PublishDirTrimmed>$([System.String]::Copy('$(PublishDir)').TrimEnd('\').TrimEnd('/'))</_PublishDirTrimmed>
      <_BrowserWww>$(_PublishDirTrimmed)\browserwww</_BrowserWww>
      <_ApiWwwRoot>$(_ApiStageDir)\wwwroot</_ApiWwwRoot>
    </PropertyGroup>
    <RemoveDir Directories="$(_ApiStageDir)" Condition="Exists('$(_ApiStageDir)')" />
    <MakeDir Directories="$(_ApiStageDir)" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\StoreAPI\StoreAPI.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -p:BuildReact=false -o &quot;$(_ApiStageDir)&quot;" />
    <Exec Command="robocopy &quot;$(_ApiStageDir)&quot; &quot;$(_PublishDirTrimmed)&quot; /E /XD wwwroot /NFL /NDL /NJH /NJS /NC /NS /NP" IgnoreExitCode="true" />
    <RemoveDir Directories="$(_BrowserWww)" Condition="Exists('$(_BrowserWww)')" />
    <MakeDir Directories="$(_BrowserWww)" Condition="Exists('$(_ApiWwwRoot)')" />
    <Exec Command="robocopy &quot;$(_ApiWwwRoot)&quot; &quot;$(_BrowserWww)&quot; /E /NFL /NDL /NJH /NJS /NC /NS /NP" IgnoreExitCode="true" Condition="Exists('$(_ApiWwwRoot)')" />
    <Error Condition="!Exists('$(_BrowserWww)\index.html')" Text="browserwww\index.html is missing after publish. Run scripts\publish-windows.ps1 (builds StoreWeb first)." />
  </Target>

  <!-- macOS (Mac Catalyst): bundle StoreAPI into .app/Contents/MacOS. -->
  <Target Name="PublishAndMergeStoreApiMac" AfterTargets="Publish" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' AND ('$(RuntimeIdentifier)' == 'maccatalyst-arm64' OR '$(RuntimeIdentifier)' == 'maccatalyst-x64')">
    <PropertyGroup>
      <_MacApiRid Condition="'$(RuntimeIdentifier)' == 'maccatalyst-arm64'">osx-arm64</_MacApiRid>
      <_MacApiRid Condition="'$(RuntimeIdentifier)' == 'maccatalyst-x64'">osx-x64</_MacApiRid>
      <_ApiStageDir>$(MSBuildThisFileDirectory)..\StoreAPI\bin\$(Configuration)\net10.0\$(_MacApiRid)\publish-staged-mac</_ApiStageDir>
      <_AppBundle>$([System.String]::Copy('$(PublishDir)').TrimEnd('/'))/$(ApplicationTitle).app</_AppBundle>
      <_MacOsDir>$(_AppBundle)/Contents/MacOS</_MacOsDir>
      <_BrowserWww>$(_MacOsDir)/browserwww</_BrowserWww>
      <_ApiWwwRoot>$(_ApiStageDir)/wwwroot</_ApiWwwRoot>
    </PropertyGroup>
    <RemoveDir Directories="$(_ApiStageDir)" Condition="Exists('$(_ApiStageDir)')" />
    <MakeDir Directories="$(_ApiStageDir)" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\StoreAPI\StoreAPI.csproj&quot; -c $(Configuration) -r $(_MacApiRid) --self-contained true -p:BuildReact=false -o &quot;$(_ApiStageDir)&quot;" />
    <ItemGroup>
      <_ApiPayload Include="$(_ApiStageDir)/**/*" Exclude="$(_ApiStageDir)/wwwroot/**" />
    </ItemGroup>
    <Copy SourceFiles="@(_ApiPayload)" DestinationFolder="$(_MacOsDir)/%(RecursiveDir)" SkipUnchangedFiles="true" Condition="Exists('$(_MacOsDir)')" />
    <Exec Command="chmod +x &quot;$(_MacOsDir)/StoreAPI&quot;" Condition="Exists('$(_MacOsDir)/StoreAPI')" />
    <RemoveDir Directories="$(_BrowserWww)" Condition="Exists('$(_BrowserWww)')" />
    <MakeDir Directories="$(_BrowserWww)" Condition="Exists('$(_ApiWwwRoot)')" />
    <ItemGroup>
      <_WebPayload Include="$(_ApiWwwRoot)/**/*" Condition="Exists('$(_ApiWwwRoot)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebPayload)" DestinationFolder="$(_BrowserWww)/%(RecursiveDir)" SkipUnchangedFiles="true" Condition="Exists('$(_ApiWwwRoot)')" />
    <Error Condition="!Exists('$(_BrowserWww)/index.html')" Text="browserwww/index.html is missing after Mac publish. Run scripts/publish-macos.sh (builds StoreWeb first)." />
  </Target>

</Project>

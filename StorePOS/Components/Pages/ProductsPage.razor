@page "/products"
@page "/stock"
@layout MainLayout
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using StoreShared
@using StoreShared.Catalog
@using StoreShared.Pos
@using StoreShared.Stock
@using StorePOS.Services
@inject HttpClient Http
@inject IJSRuntime Js
@inject StoreSettingsService StoreSettings
@inject ToastService Toasts
@inject BarcodePrintHelper BarcodePrint
@inject AppState App

<PageTitle>Products</PageTitle>

<h1>Products</h1>

@if (_reloading && _products is not null)
{
    <div class="page-loading-overlay" aria-busy="true">
        <div class="page-loading-inner">
            <span class="spinner" aria-hidden="true"></span>
            <span>Refreshing…</span>
        </div>
    </div>
}

@if (_error is not null)
{
    <p class="error">@_error</p>
}

<p class="muted">
    @if (IsAdmin)
    {
        <span>Add products with name, prices, and starting stock. Adjust stock inline or print barcode labels.</span>
    }
    else
    {
        <span>View stock levels and print barcode labels.</span>
    }
    @if (_lowStockThreshold > 0)
    {
        <span> Below @_lowStockThreshold: amber; zero: red.</span>
    }
</p>

@if (IsAdmin)
{
    <div class="admin-toolbar">
        <button type="button" class="btn secondary" @onclick="() => _showAddForm = !_showAddForm">
            @(_showAddForm ? "Hide add product" : "Add product")
        </button>
        <button type="button" class="btn secondary" disabled="@(_products is null || _products.Count == 0)" @onclick="ExportCatalogAsync">
            @(_exportBusy ? "Exporting…" : "Export products")
        </button>
        <label class="btn secondary" style="margin:0; cursor:@(_importBusy ? "default" : "pointer")">
            @(_importBusy ? "Importing…" : "Import products")
            <InputFile OnChange="OnImportFileSelected" accept=".json,application/json" disabled="@_importBusy" style="display:none" />
        </label>
    </div>
}

@if (IsAdmin && _showAddForm)
{
    <section class="admin-card">
        <h2>New product</h2>
        <EditForm Model="_newProduct" OnValidSubmit="CreateProductAsync">
            <div class="field">
                <label for="pm-name">Name</label>
                <InputText id="pm-name" class="input" @bind-Value="_newProduct.Name" autocomplete="off" />
            </div>
            <div class="field">
                <label for="pm-buy">Buy price (@StoreSettings.CurrencyLabel)</label>
                <InputNumber id="pm-buy" class="input" @bind-Value="_newProduct.BuyPrice" />
            </div>
            <div class="field">
                <label for="pm-price">Sell price (@StoreSettings.CurrencyLabel)</label>
                <InputNumber id="pm-price" class="input" @bind-Value="_newProduct.UnitPrice" />
            </div>
            <div class="field">
                <label for="pm-sale">Sale price (@StoreSettings.CurrencyLabel, optional)</label>
                <InputNumber id="pm-sale" class="input" @bind-Value="_newProduct.SalePrice" />
            </div>
            <div class="field">
                <label for="pm-stock">Initial stock</label>
                <InputNumber id="pm-stock" class="input" @bind-Value="_newProduct.InitialStock" />
            </div>
            <button type="submit" class="btn primary" disabled="@_busyAdd">
                @if (_busyAdd)
                {
                    <span class="spinner spinner-sm" aria-hidden="true"></span>
                }
                @(_busyAdd ? "Saving…" : "Save product")
            </button>
        </EditForm>
    </section>
}

<div class="stock-toolbar">
    <label class="filter-label" for="product-filter">Search (name)</label>
    <input id="product-filter" class="input filter-input" @bind="_nameFilter" @bind:event="oninput" placeholder="Product name…" />
    <button type="button" class="btn primary" @onclick="ReloadAsync" disabled="@_loading">
        @if (_loading)
        {
            <span class="spinner spinner-sm" aria-hidden="true"></span><span>Loading…</span>
        }
        else
        {
            <span>Refresh</span>
        }
    </button>
</div>

@if (_products is null)
{
    <p class="loading-with-spinner"><span class="spinner spinner-sm" aria-hidden="true"></span> Loading…</p>
}
else
{
    <div class="table-wrap">
        <table class="stock-table">
            <thead>
            <tr>
                <th>Name</th>
                <th>Buy</th>
                <th>Sell</th>
                <th>Barcode</th>
                <th>Label</th>
                <th>Stock</th>
                @if (IsAdmin)
                {
                    <th>Actions</th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var row in Filtered)
            {
                <tr class="@RowClass(row)">
                    <td>@row.Name</td>
                    <td>@MoneyFormat.Format(row.BuyPrice, StoreSettings.CurrencyLabel)</td>
                    <td>
                        @if (Pricing.IsOnSale(row.UnitPrice, row.SalePrice))
                        {
                            <span class="price-strike">@MoneyFormat.Format(row.UnitPrice, StoreSettings.CurrencyLabel)</span>
                            <strong class="price-sale">@MoneyFormat.Format(row.SalePrice!.Value, StoreSettings.CurrencyLabel)</strong>
                        }
                        else
                        {
                            @MoneyFormat.Format(row.UnitPrice, StoreSettings.CurrencyLabel)
                        }
                    </td>
                    <td class="mono">@row.Barcode</td>
                    <td class="stock-barcode-cell">
                        @if (!string.IsNullOrEmpty(row.BarcodePngBase64))
                        {
                            <img src="@($"data:image/png;base64,{row.BarcodePngBase64}")" class="stock-barcode-thumb" alt="" />
                        }
                        <button type="button" class="btn-link stock-print-link" @onclick="() => OpenPrintModal(row)" disabled="@(string.IsNullOrEmpty(row.Barcode))">Print</button>
                    </td>
                    <td>
                        @if (IsAdmin && _editingProductId == row.Id)
                        {
                            <input type="number"
                                   class="input inline-num"
                                   min="0"
                                   @bind="_editQuantity"
                                   @bind:event="oninput"
                                   @onkeydown="e => OnStockEditKeydownAsync(e, row.Id)" />
                        }
                        else if (IsAdmin)
                        {
                            <button type="button" class="btn-link stock-qty-hit" @onclick="() => StartEdit(row)" disabled="@(_editingProductId != null)">
                                @row.Stock
                            </button>
                        }
                        else
                        {
                            @row.Stock
                        }
                    </td>
                    @if (IsAdmin)
                    {
                        <td class="stock-actions">
                            <button type="button" class="btn secondary btn-sm" disabled="@(_addingProductId == row.Id)" @onclick="() => AddStockAsync(row)">
                                @(_addingProductId == row.Id ? "…" : "+ Add")
                            </button>
                            <input type="number" class="input inline-num stock-add-qty" min="1" value="@GetAddQty(row.Id)" @onchange="e => OnAddQtyChange(row.Id, e)" />
                            <button type="button" class="btn-link" @onclick="() => OpenPriceModal(row)">Prices</button>
                            <button type="button" class="btn-link" @onclick="() => OpenRenameModal(row)">Rename</button>
                            <button type="button" class="btn-link danger-link" disabled="@(_deletingProductId == row.Id)" @onclick="() => DeleteProductAsync(row)">@(_deletingProductId == row.Id ? "…" : "Delete")</button>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (_printModalOpen && _printRow is not null)
{
    <div class="modal-backdrop" @onclick="ClosePrintModal"></div>
    <div class="modal-panel" @onclick:stopPropagation="true">
        <div class="modal-header">
            <h2 class="modal-title">Print barcodes</h2>
            <button type="button" class="btn-link modal-close" aria-label="Close" @onclick="ClosePrintModal">✕</button>
        </div>
        <div class="modal-body">
            <p class="muted print-modal-summary">
                <strong>@_printRow.Name</strong> · <span class="mono">@_printRow.Barcode</span>
            </p>
            <div class="field">
                <label for="product-print-qty">How many labels?</label>
                <input id="product-print-qty" type="number" class="input" min="1" max="500" @bind="_printCount" @onkeydown="OnPrintModalKeyAsync" />
            </div>
            <div class="modal-actions">
                <button type="button" class="btn primary touch-target" @onclick="ConfirmPrintAsync" disabled="@_printBusy">
                    @if (_printBusy)
                    {
                        <span class="spinner spinner-sm" aria-hidden="true"></span>
                    }
                    Print
                </button>
                <button type="button" class="btn secondary touch-target" @onclick="ClosePrintModal" disabled="@_printBusy">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_priceModalOpen)
{
    <div class="modal-backdrop" @onclick="ClosePriceModal"></div>
    <div class="modal-panel" @onclick:stopPropagation="true">
        <div class="modal-header">
            <h2 class="modal-title">Edit prices — @_priceModal.Title</h2>
            <button type="button" class="btn-link modal-close" aria-label="Close" @onclick="ClosePriceModal">✕</button>
        </div>
        <div class="modal-body">
            <EditForm Model="_priceModal" OnValidSubmit="SubmitPriceModalAsync">
                <div class="field">
                    <label for="price-modal-buy">Buy price (@StoreSettings.CurrencyLabel)</label>
                    <InputNumber id="price-modal-buy" class="input" @bind-Value="_priceModal.BuyPrice" />
                </div>
                <div class="field">
                    <label for="price-modal-unit">Sell price (@StoreSettings.CurrencyLabel)</label>
                    <InputNumber id="price-modal-unit" class="input" @bind-Value="_priceModal.UnitPrice" />
                </div>
                <div class="field">
                    <label for="price-modal-sale">Sale price (@StoreSettings.CurrencyLabel, optional)</label>
                    <InputNumber id="price-modal-sale" class="input" @bind-Value="_priceModal.SalePrice" />
                </div>
                <button type="submit" class="btn primary" disabled="@_busyPriceModal">Save prices</button>
            </EditForm>
        </div>
    </div>
}

@if (_renameModalOpen)
{
    <div class="modal-backdrop" @onclick="CloseRenameModal"></div>
    <div class="modal-panel" @onclick:stopPropagation="true">
        <div class="modal-header">
            <h2 class="modal-title">Rename product</h2>
            <button type="button" class="btn-link modal-close" aria-label="Close" @onclick="CloseRenameModal">✕</button>
        </div>
        <div class="modal-body">
            <EditForm Model="_renameModal" OnValidSubmit="SubmitRenameModalAsync">
                <div class="field">
                    <label for="rename-name">Name</label>
                    <InputText id="rename-name" class="input" @bind-Value="_renameModal.Name" autocomplete="off" />
                </div>
                <button type="submit" class="btn primary" disabled="@_busyRenameModal">Save</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private bool IsAdmin => string.Equals(App.Role, nameof(UserRole.Admin), StringComparison.OrdinalIgnoreCase);

    private List<ProductModelSummaryDto>? _products;
    private string _nameFilter = "";
    private string? _error;
    private bool _loading;
    private bool _reloading;
    private bool _showAddForm;
    private bool _busyAdd;
    private bool _exportBusy;
    private bool _importBusy;
    private int _lowStockThreshold = 5;

    private int? _editingProductId;
    private int? _addingProductId;
    private int? _deletingProductId;
    private int _editQuantity;
    private readonly Dictionary<int, int> _addQtyByProduct = new();

    private bool _printModalOpen;
    private bool _printBusy;
    private ProductModelSummaryDto? _printRow;
    private int _printCount = 1;

    private bool _priceModalOpen;
    private bool _busyPriceModal;
    private readonly PriceModalForm _priceModal = new();

    private bool _renameModalOpen;
    private bool _busyRenameModal;
    private readonly RenameModalForm _renameModal = new();

    private readonly NewProductForm _newProduct = new();

    private IEnumerable<ProductModelSummaryDto> Filtered =>
        string.IsNullOrWhiteSpace(_nameFilter)
            ? _products ?? Enumerable.Empty<ProductModelSummaryDto>()
            : (_products ?? Enumerable.Empty<ProductModelSummaryDto>())
                .Where(r => r.Name.Contains(_nameFilter.Trim(), StringComparison.OrdinalIgnoreCase));

    private string? RowClass(ProductModelSummaryDto row)
    {
        if (row.Stock == 0)
            return "stock-zero";
        if (_lowStockThreshold > 0 && row.Stock < _lowStockThreshold)
            return "stock-low";
        return null;
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _error = null;
        _loading = true;
        _reloading = _products is not null;
        _editingProductId = null;
        try
        {
            var settings = await Http.GetFromJsonAsync<PosSettingsDto>("api/settings", AppJson.Options);
            _lowStockThreshold = settings?.LowStockThreshold ?? 5;
            _products = await Http.GetFromJsonAsync<List<ProductModelSummaryDto>>("api/products", AppJson.Options) ?? new();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _products ??= new();
        }
        finally
        {
            _loading = false;
            _reloading = false;
        }
    }

    private async Task CreateProductAsync()
    {
        _error = null;
        _busyAdd = true;
        try
        {
            var body = new CreateProductModelRequest(
                _newProduct.Name.Trim(),
                null,
                Math.Max(0, _newProduct.BuyPrice),
                Math.Max(0, _newProduct.UnitPrice),
                _newProduct.SalePrice,
                Math.Max(0, _newProduct.InitialStock));
            using var resp = await Http.PostAsJsonAsync("api/products", body, AppJson.Options);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await resp.Content.ReadAsStringAsync();
                Toasts.Error(string.IsNullOrWhiteSpace(_error) ? "Could not save product." : _error);
                return;
            }

            _newProduct.Name = "";
            _newProduct.BuyPrice = 0;
            _newProduct.UnitPrice = 0;
            _newProduct.SalePrice = null;
            _newProduct.InitialStock = 0;
            _showAddForm = false;
            Toasts.Success("Product saved");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toasts.Error(ex.Message);
        }
        finally
        {
            _busyAdd = false;
        }
    }

    private void StartEdit(ProductModelSummaryDto row)
    {
        _editingProductId = row.Id;
        _editQuantity = row.Stock;
    }

    private void CancelEdit() => _editingProductId = null;

    private async Task OnStockEditKeydownAsync(KeyboardEventArgs e, int productId)
    {
        if (e.Key == "Enter")
            await SaveStockAsync(productId);
        else if (e.Key == "Escape")
            CancelEdit();
    }

    private async Task SaveStockAsync(int productId)
    {
        if (_editQuantity < 0)
        {
            _error = "Stock cannot be negative.";
            return;
        }

        _error = null;
        try
        {
            using var resp = await Http.PutAsJsonAsync($"api/products/{productId}/stock", new SetStockRequest(_editQuantity), AppJson.Options);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await resp.Content.ReadAsStringAsync();
                Toasts.Error(_error ?? "Save failed.");
                return;
            }

            _editingProductId = null;
            Toasts.Success("Stock saved");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toasts.Error(ex.Message);
        }
    }

    private int GetAddQty(int productId) => _addQtyByProduct.TryGetValue(productId, out var q) ? q : 1;

    private void OnAddQtyChange(int productId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
            _addQtyByProduct[productId] = Math.Max(1, n);
    }

    private async Task AddStockAsync(ProductModelSummaryDto row)
    {
        var qty = GetAddQty(row.Id);
        _addingProductId = row.Id;
        try
        {
            using var resp = await Http.PostAsJsonAsync($"api/products/{row.Id}/stock/add", new AdjustStockRequest(qty), AppJson.Options);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await resp.Content.ReadAsStringAsync();
                Toasts.Error(_error ?? "Could not add stock.");
                return;
            }

            Toasts.Success("Stock updated");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toasts.Error(ex.Message);
        }
        finally
        {
            _addingProductId = null;
        }
    }

    private void OpenPrintModal(ProductModelSummaryDto row)
    {
        _printRow = row;
        _printCount = 1;
        _printModalOpen = true;
    }

    private void ClosePrintModal()
    {
        _printModalOpen = false;
        _printRow = null;
        _printBusy = false;
    }

    private async Task OnPrintModalKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ConfirmPrintAsync();
        else if (e.Key == "Escape")
            ClosePrintModal();
    }

    private async Task ConfirmPrintAsync()
    {
        if (_printRow is null || string.IsNullOrEmpty(_printRow.Barcode))
            return;

        var count = Math.Clamp(_printCount, 1, 500);
        _printCount = count;
        _printBusy = true;
        await BarcodePrint.BeginBrowserPrintAsync();
        try
        {
            var key = Uri.EscapeDataString(_printRow.Barcode);
            var detail = await Http.GetFromJsonAsync<SkuDetailDto>($"api/skus/{key}?forLabelPrint=true", AppJson.Options);
            var png = detail?.BarcodePngBase64;
            if (string.IsNullOrEmpty(png))
            {
                _error = "Could not load barcode image for printing.";
                Toasts.Error(_error);
                await BarcodePrint.CancelBrowserPrintAsync();
                return;
            }

            var (ok, usedNative, printError) = await BarcodePrint.PrintAsync(png, count);
            if (!ok)
            {
                _error = printError ?? "Print failed.";
                Toasts.Error(_error);
            }
            else
            {
                Toasts.Success(usedNative
                    ? $"Sent {count} label{(count == 1 ? "" : "s")} to barcode printer"
                    : $"Printing {count} label{(count == 1 ? "" : "s")}");
                ClosePrintModal();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toasts.Error(ex.Message);
            await BarcodePrint.CancelBrowserPrintAsync();
        }
        finally
        {
            _printBusy = false;
        }
    }

    private void OpenPriceModal(ProductModelSummaryDto row)
    {
        _priceModal.ProductId = row.Id;
        _priceModal.Title = row.Name;
        _priceModal.BuyPrice = row.BuyPrice;
        _priceModal.UnitPrice = row.UnitPrice;
        _priceModal.SalePrice = row.SalePrice;
        _priceModalOpen = true;
    }

    private void ClosePriceModal() => _priceModalOpen = false;

    private async Task SubmitPriceModalAsync()
    {
        _busyPriceModal = true;
        try
        {
            var body = new UpdateProductPriceRequest(Math.Max(0, _priceModal.BuyPrice), Math.Max(0, _priceModal.UnitPrice), _priceModal.SalePrice);
            using var resp = await Http.PutAsJsonAsync($"api/products/{_priceModal.ProductId}/price", body, AppJson.Options);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await resp.Content.ReadAsStringAsync();
                Toasts.Error(_error ?? "Could not save prices.");
                return;
            }

            Toasts.Success("Prices saved");
            _priceModalOpen = false;
            await ReloadAsync();
        }
        finally
        {
            _busyPriceModal = false;
        }
    }

    private void OpenRenameModal(ProductModelSummaryDto row)
    {
        _renameModal.ProductId = row.Id;
        _renameModal.Name = row.Name;
        _renameModalOpen = true;
    }

    private void CloseRenameModal() => _renameModalOpen = false;

    private async Task SubmitRenameModalAsync()
    {
        _busyRenameModal = true;
        try
        {
            var body = new UpdateProductModelRequest(_renameModal.Name.Trim(), null);
            using var resp = await Http.PutAsJsonAsync($"api/products/{_renameModal.ProductId}", body, AppJson.Options);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await resp.Content.ReadAsStringAsync();
                Toasts.Error(_error ?? "Could not rename.");
                return;
            }

            Toasts.Success("Product renamed");
            _renameModalOpen = false;
            await ReloadAsync();
        }
        finally
        {
            _busyRenameModal = false;
        }
    }

    private async Task DeleteProductAsync(ProductModelSummaryDto row)
    {
        var ok = await Js.InvokeAsync<bool>("storePosConfirm", $"Delete \"{row.Name}\"? This cannot be undone.");
        if (!ok)
            return;

        _deletingProductId = row.Id;
        try
        {
            using var resp = await Http.DeleteAsync($"api/products/{row.Id}");
            if (!resp.IsSuccessStatusCode)
            {
                _error = await resp.Content.ReadAsStringAsync();
                Toasts.Error(_error ?? "Delete failed.");
                return;
            }

            Toasts.Success("Product deleted");
            await ReloadAsync();
        }
        finally
        {
            _deletingProductId = null;
        }
    }

    private async Task ExportCatalogAsync()
    {
        _exportBusy = true;
        try
        {
            var bytes = await Http.GetByteArrayAsync("api/products/export");
            var fname = $"catalog-export-{DateTime.UtcNow:yyyyMMdd}.json";
            var b64 = Convert.ToBase64String(bytes);
            var ok = await Js.InvokeAsync<bool>("storeDownloadFile", fname, b64, "application/json");
            if (ok)
                Toasts.Success("Catalog exported");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            _exportBusy = false;
        }
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        var ok = await Js.InvokeAsync<bool>("storePosConfirm", "Import products from this file?");
        if (!ok)
            return;

        _importBusy = true;
        try
        {
            await using var stream = file.OpenReadStream(10L * 1024 * 1024);
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue("application/json");
            content.Add(fileContent, "file", file.Name);

            using var resp = await Http.PostAsync("api/products/import", content);
            var result = await resp.Content.ReadFromJsonAsync<CatalogImportResultDto>(AppJson.Options);
            if (!resp.IsSuccessStatusCode || result is null || !result.Success)
            {
                Toasts.Error(result?.Message ?? "Import failed.");
                return;
            }

            Toasts.Success(result.Message);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
        finally
        {
            _importBusy = false;
        }
    }

    private sealed class NewProductForm
    {
        public string Name { get; set; } = "";
        public decimal BuyPrice { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal? SalePrice { get; set; }
        public int InitialStock { get; set; }
    }

    private sealed class PriceModalForm
    {
        public int ProductId { get; set; }
        public string Title { get; set; } = "";
        public decimal BuyPrice { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal? SalePrice { get; set; }
    }

    private sealed class RenameModalForm
    {
        public int ProductId { get; set; }
        public string Name { get; set; } = "";
    }
}

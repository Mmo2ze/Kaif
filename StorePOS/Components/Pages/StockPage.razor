@page "/stock"
@layout MainLayout
@attribute [AdminRoute]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@using StorePOS.Services
@using StoreShared.Catalog
@using StoreShared.Pos
@using StoreShared.Stock
@inject HttpClient Http
@inject ToastService Toasts
@inject BarcodePrintHelper BarcodePrint

<PageTitle>Stock</PageTitle>

<h1>Stock</h1>

@if (_loading && _rows is not null)
{
    <div class="page-loading-overlay" aria-busy="true">
        <div class="page-loading-inner">
            <span class="spinner" aria-hidden="true"></span>
            <span>Refreshing stock…</span>
        </div>
    </div>
}

<p class="muted">
    Filter by product model, adjust quantities inline (Enter to save), or add stock with +.
    @if (_lowStockThreshold > 0)
    {
        <span>Below @_lowStockThreshold: amber; zero: red.</span>
    }
</p>

<div class="stock-toolbar">
    <label class="filter-label" for="stock-filter">Search (model name)</label>
    <input id="stock-filter" class="input filter-input" @bind="_modelFilter" @bind:event="oninput" placeholder="Model name…" />
    <button type="button" class="btn primary" @onclick="ReloadAsync" disabled="@_loading">
        @if (_loading)
        {
            <span class="spinner spinner-sm" aria-hidden="true"></span><span>Loading…</span>
        }
        else
        {
            <span>Refresh</span>
        }
    </button>
</div>

@if (_error is not null)
{
    <p class="error">@_error</p>
}
else if (_rows is null)
{
    <p class="loading-with-spinner"><span class="spinner spinner-sm" aria-hidden="true"></span> Loading…</p>
}
else
{
    <div class="table-wrap">
        <table class="stock-table">
            <thead>
            <tr>
                <th>Model</th>
                <th>Size</th>
                <th>Barcode</th>
                <th>Image</th>
                <th>Current stock</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var row in Filtered)
            {
                <tr class="@RowClass(row)">
                    <td>@row.ModelName</td>
                    <td>@row.Size</td>
                    <td class="mono">@row.Barcode</td>
                    <td class="stock-barcode-cell">
                        @if (!string.IsNullOrEmpty(row.BarcodePngBase64))
                        {
                            <img src="@($"data:image/png;base64,{row.BarcodePngBase64}")" class="stock-barcode-thumb" alt="" />
                        }
                        <button type="button" class="btn-link stock-print-link" @onclick="() => OpenPrintModal(row)" disabled="@(string.IsNullOrEmpty(row.BarcodePngBase64))">Print</button>
                    </td>
                    <td>
                        @if (_editingSkuId == row.SkuId)
                        {
                            <input type="number"
                                   class="input inline-num"
                                   min="0"
                                   @bind="_editQuantity"
                                   @bind:event="oninput"
                                   @onkeydown="e => OnStockEditKeydownAsync(e, row.SkuId)" />
                        }
                        else
                        {
                            <button type="button" class="btn-link stock-qty-hit" @onclick="() => StartEdit(row)" disabled="@(_editingSkuId != null)">
                                @row.Stock
                            </button>
                        }
                    </td>
                    <td class="actions">
                        @if (_editingSkuId == row.SkuId)
                        {
                            <button type="button" class="btn-link" @onclick="() => SaveEditAsync(row.SkuId)" disabled="@_saving">
                                @if (_saving)
                                {
                                    <span class="spinner spinner-sm" aria-hidden="true"></span>
                                }
                                Save
                            </button>
                            <button type="button" class="btn-link" @onclick="CancelEdit" disabled="@_saving">Cancel</button>
                        }
                        else
                        {
                            <span class="stock-add-inline">
                                <input type="number"
                                       class="input stock-add-input"
                                       min="1"
                                       value="@GetAddQty(row.SkuId)"
                                       @onchange="e => OnAddQtyChange(row.SkuId, e)" />
                                <button type="button" class="btn secondary stock-add-btn" @onclick="() => AddStockAsync(row)" disabled="@(_addingSkuId == row.SkuId)" title="Add to stock">+</button>
                            </span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (_printModalOpen && _printRow is not null)
{
    <div class="modal-backdrop" @onclick="ClosePrintModal"></div>
    <div class="modal-panel" @onclick:stopPropagation="true">
        <div class="modal-header">
            <h2 class="modal-title">Print barcodes</h2>
            <button type="button" class="btn-link modal-close" aria-label="Close" @onclick="ClosePrintModal">✕</button>
        </div>
        <div class="modal-body">
            <p class="muted print-modal-summary">
                <strong>@_printRow.ModelName</strong> · @_printRow.Size · <span class="mono">@_printRow.Barcode</span>
            </p>
            <div class="field">
                <label for="stock-print-qty">How many labels?</label>
                <input id="stock-print-qty"
                       type="number"
                       class="input"
                       min="1"
                       max="500"
                       @bind="_printCount"
                       @bind:event="oninput"
                       @onkeydown="OnPrintModalKeyAsync" />
            </div>
            <div class="modal-actions">
                <button type="button" class="btn primary touch-target" @onclick="ConfirmPrintAsync" disabled="@_printBusy">
                    @if (_printBusy)
                    {
                        <span class="spinner spinner-sm" aria-hidden="true"></span>
                    }
                    Print
                </button>
                <button type="button" class="btn secondary touch-target" @onclick="ClosePrintModal" disabled="@_printBusy">Cancel</button>
            </div>
        </div>
    </div>
}

<h2 class="settings-section-title" style="margin-top:2rem;">Stock adjustment history</h2>
<p class="muted small">Includes refunds and manual stock changes linked to sale events.</p>
@if (_adjustmentsLoading)
{
    <p class="muted">Loading…</p>
}
else if (_adjustments is not null && _adjustments.Count > 0)
{
    <div class="table-wrap">
        <table class="stock-table">
            <thead>
            <tr>
                <th>When</th>
                <th>Model</th>
                <th>Size</th>
                <th class="col-num">Qty</th>
                <th>Reason</th>
                <th>By</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var a in _adjustments)
            {
                <tr>
                    <td>@a.Timestamp.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@a.ModelName</td>
                    <td>@a.Size</td>
                    <td class="col-num">@((a.QuantityDelta > 0 ? "+" : "") + a.QuantityDelta)</td>
                    <td class="mono small">@a.Reason</td>
                    <td>@a.PerformedBy</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else if (_adjustments is not null)
{
    <p class="muted">No adjustments in the last 30 days.</p>
}

@code {
    private List<StockRowDto>? _rows;
    private string _modelFilter = "";
    private string? _error;
    private bool _loading;
    private bool _saving;
    private int? _editingSkuId;
    private int? _addingSkuId;
    private int _editQuantity;
    private int _lowStockThreshold = 5;
    private readonly Dictionary<int, int> _addQtyBySku = new();
    private bool _printModalOpen;
    private bool _printBusy;
    private StockRowDto? _printRow;
    private int _printCount = 1;
    private IReadOnlyList<StockAdjustmentDto>? _adjustments;
    private bool _adjustmentsLoading;

    private IEnumerable<StockRowDto> Filtered =>
        string.IsNullOrWhiteSpace(_modelFilter)
            ? _rows ?? Enumerable.Empty<StockRowDto>()
            : (_rows ?? Enumerable.Empty<StockRowDto>())
                .Where(r => r.ModelName.Contains(_modelFilter.Trim(), StringComparison.OrdinalIgnoreCase));

    private string? RowClass(StockRowDto row)
    {
        if (row.Stock == 0)
            return "stock-zero";
        if (_lowStockThreshold > 0 && row.Stock < _lowStockThreshold)
            return "stock-low";
        return null;
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _error = null;
        _loading = true;
        _editingSkuId = null;
        try
        {
            var settings = await Http.GetFromJsonAsync<PosSettingsDto>("api/settings", AppJson.Options);
            _lowStockThreshold = settings?.LowStockThreshold ?? 5;

            _rows = await Http.GetFromJsonAsync<List<StockRowDto>>("api/stock", AppJson.Options) ?? new();
            _ = LoadAdjustmentsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _rows ??= new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartEdit(StockRowDto row)
    {
        _editingSkuId = row.SkuId;
        _editQuantity = row.Stock;
    }

    private void CancelEdit() => _editingSkuId = null;

    private async Task OnStockEditKeydownAsync(KeyboardEventArgs e, int skuId)
    {
        if (e.Key == "Enter")
            await SaveEditAsync(skuId);
        else if (e.Key == "Escape")
            CancelEdit();
    }

    private async Task SaveEditAsync(int skuId)
    {
        if (_editQuantity < 0)
        {
            _error = "Stock cannot be negative.";
            return;
        }

        _error = null;
        _saving = true;
        try
        {
            using var resp = await Http.PutAsJsonAsync($"api/stock/{skuId}", new SetStockRequest(_editQuantity), AppJson.Options);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await resp.Content.ReadAsStringAsync();
                Toasts.Error(string.IsNullOrWhiteSpace(_error) ? "Save failed." : _error);
                return;
            }

            _editingSkuId = null;
            Toasts.Success("Stock saved");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toasts.Error(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private int GetAddQty(int skuId) => _addQtyBySku.TryGetValue(skuId, out var q) ? q : 1;

    private void OnAddQtyChange(int skuId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
            _addQtyBySku[skuId] = Math.Max(1, n);
    }

    private async Task AddStockAsync(StockRowDto row)
    {
        var qty = GetAddQty(row.SkuId);
        _error = null;
        _addingSkuId = row.SkuId;
        try
        {
            using var resp = await Http.PostAsJsonAsync($"api/stock/{row.SkuId}/add", new AdjustStockRequest(qty), AppJson.Options);
            if (!resp.IsSuccessStatusCode)
            {
                _error = await resp.Content.ReadAsStringAsync();
                Toasts.Error(_error ?? "Could not add stock.");
                return;
            }

            Toasts.Success("Stock updated");
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toasts.Error(ex.Message);
        }
        finally
        {
            _addingSkuId = null;
        }
    }

    private void OpenPrintModal(StockRowDto row)
    {
        if (string.IsNullOrEmpty(row.BarcodePngBase64))
            return;
        _printRow = row;
        _printCount = 1;
        _printModalOpen = true;
    }

    private void ClosePrintModal()
    {
        _printModalOpen = false;
        _printRow = null;
        _printBusy = false;
    }

    private async Task OnPrintModalKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ConfirmPrintAsync();
        else if (e.Key == "Escape")
            ClosePrintModal();
    }

    private async Task<string?> FetchLabelBarcodePngAsync(string barcode)
    {
        var key = Uri.EscapeDataString(barcode);
        var detail = await Http.GetFromJsonAsync<SkuDetailDto>($"api/skus/{key}?forLabelPrint=true", AppJson.Options);
        return detail?.BarcodePngBase64;
    }

    private async Task LoadAdjustmentsAsync()
    {
        _adjustmentsLoading = true;
        try
        {
            var to = DateOnly.FromDateTime(DateTime.Today);
            var from = to.AddDays(-30);
            var result = await Http.GetFromJsonAsync<PagedStockAdjustmentsResult>(
                $"api/stock/adjustments?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}&page=1&pageSize=100",
                AppJson.Options);
            _adjustments = result?.Items ?? Array.Empty<StockAdjustmentDto>();
        }
        catch
        {
            _adjustments = Array.Empty<StockAdjustmentDto>();
        }
        finally
        {
            _adjustmentsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConfirmPrintAsync()
    {
        if (_printRow is null || string.IsNullOrEmpty(_printRow.BarcodePngBase64))
            return;

        var count = Math.Clamp(_printCount, 1, 500);
        _printCount = count;
        _error = null;
        _printBusy = true;
        try
        {
            var png = await FetchLabelBarcodePngAsync(_printRow.Barcode);
            if (string.IsNullOrEmpty(png))
            {
                _error = "Could not load barcode image for printing.";
                Toasts.Error(_error);
                return;
            }

            var (ok, usedNative, printError) = await BarcodePrint.PrintAsync(png, count);
            if (!ok)
            {
                _error = printError ?? "Print failed.";
                Toasts.Error(_error);
            }
            else
            {
                Toasts.Success(usedNative
                    ? $"Sent {count} label{(count == 1 ? "" : "s")} to barcode printer"
                    : $"Printing {count} label{(count == 1 ? "" : "s")}");
                ClosePrintModal();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toasts.Error(ex.Message);
        }
        finally
        {
            _printBusy = false;
        }
    }
}
